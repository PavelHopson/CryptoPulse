# Reserved for a future server gateway. Never expose a provider key in the browser build.
GEMINI_API_KEY=

# AI transport boundary. Keep client mode until a server gateway with auth, rate limits and usage accounting exists.
VITE_AI_GATEWAY_MODE=client
VITE_AI_GATEWAY_URL=

# Optional authenticated Research API. Empty keeps Strategy Lab local-only.
VITE_RESEARCH_API_URL=

# News Parser Worker URL (optional - enables real-time news from CoinTelegraph, CoinDesk etc.)
# Deploy workers/news-parser/ to Cloudflare Workers, then paste the URL here
VITE_NEWS_API=

# App Environment
VITE_APP_ENV=development

# Local-only development admin panel. Never use this as production auth.
# A server-backed account is required before exposing /admin publicly.
VITE_LOCAL_ADMIN_PASSWORD=

# Future Eclipse Library/Chat education sync. Keep disabled until the server contract exists.
VITE_EDUCATION_INTEGRATION_ENABLED=false
